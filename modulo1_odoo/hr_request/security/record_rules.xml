<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rule_hr_request_own_records" model="ir.rule">
        <field name="name">HR Request: solo registros propios</field>
        <field name="model_id" ref="model_hr_request"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_hr_request_manager_all" model="ir.rule">
        <field name="name">HR Request: manager ve todo</field>
        <field name="model_id" ref="model_hr_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>